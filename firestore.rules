rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return callerRole() == 'admin';
    }

    // Vai trò thực tế trong hệ thống: admin | mod | student | pending_teacher.
    // Giáo viên được duyệt sẽ có role 'mod' (xem admin/users). Không có role 'teacher'.
    function isStaff() {
      return callerRole() in ['admin', 'mod'];
    }

    function isAdminOrMod() {
      return callerRole() in ['admin', 'mod'];
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'mrhoangblue@gmail.com';
    }

    function ownsClass(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId
        == request.auth.uid;
    }

    // ── Người dùng ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Giáo viên đã duyệt có hồ sơ tìm kiếm được bởi người dùng đã đăng nhập.
      allow read: if isSignedIn() && (
        isOwner(userId)
        || isAdminOrMod()
        || resource.data.role in ['admin', 'mod']
      );

      // Tài khoản mới tự tạo hồ sơ nhưng không thể tự cấp quyền mod/admin.
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && (
          request.resource.data.role in ['student', 'pending_teacher']
          || (isBootstrapAdmin() && request.resource.data.role == 'admin')
        );

      // Chính chủ chỉ sửa các trường hồ sơ; role do admin/mod quản lý.
      allow update: if isOwner(userId) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'school', 'phoneNumber', 'searchKeywords', 'class', 'updatedAt'
        ])
        || (isBootstrapAdmin() && request.resource.data.role == 'admin')
      );

      // Chỉ admin quản lý tài khoản (cấp role, khóa, xóa). Mod KHÔNG được đổi role
      // hay sửa tài khoản người khác, tránh tự nâng quyền lên admin.
      allow create, update, delete: if isSignedIn() && isAdmin();
    }

    // ── Đề thi ─────────────────────────────────────────────────────────────────
    match /exams/{examId} {
      // Tài liệu đề chứa đáp án và lời giải nên chỉ giáo viên/admin đọc trực tiếp.
      // Học sinh nhận đề (đã gỡ đáp án) qua /api/exams/[id]/access và xem lại qua
      // /api/submissions/review sau khi nộp.
      allow read: if isSignedIn() && isStaff();

      // Giáo viên/mod/admin tạo đề — API dùng Admin SDK nên rule này chỉ
      // áp dụng nếu client ghi trực tiếp (không qua API)
      allow create: if isSignedIn() && isStaff()
        && request.resource.data.authorEmail == request.auth.token.email;

      // Chỉnh sửa/xóa: tác giả của đề HOẶC admin (mod không sửa đề của người khác)
      allow update, delete: if isSignedIn() && (
        resource.data.authorEmail == request.auth.token.email
        || isAdmin()
      );
    }

    // Mật khẩu đề chỉ được đọc/ghi bởi API dùng Admin SDK.
    match /exam_secrets/{examId} {
      allow read, write: if false;
    }

    // ── Bài nộp của học sinh ────────────────────────────────────────────────────
    match /submissions/{submissionId} {
      // Học sinh xem bài của mình, admin/mod xem tất cả
      // (TODO Bước 2: chuyển phần staff sang API để mod chỉ thấy bài của đề mình).
      allow read: if isSignedIn() && (
        resource.data.studentEmail == request.auth.token.email
        || isAdminOrMod()
      );

      // Bài nộp chỉ do máy chủ (Admin SDK) tạo, chấm và chốt điểm qua /api/submissions.
      // Client không được tạo, sửa điểm/trạng thái hay xóa.
      allow create, delete: if false;

      // Client chỉ được ghi TIẾN ĐỘ khi bài còn IN_PROGRESS và là của chính chủ.
      // Không có status, scores, part*Results, studentEmail, examId... trong danh sách.
      allow update: if isSignedIn()
        && resource.data.studentEmail == request.auth.token.email
        && resource.data.status == "IN_PROGRESS"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'answersJson', 'activityLog', 'questionTimings', 'totalElapsedSeconds',
          'lastInteractionAtSeconds', 'idleBeforeSubmitSeconds',
          'currentQuestionIndex', 'lastActivityAt'
        ]);
    }

    // ── Lớp học ────────────────────────────────────────────────────────────────
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isStaff();

      // Thêm/xóa học sinh đi qua API máy chủ để bảo đảm quy trình chờ duyệt.
      allow update: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid
        || isAdmin()
      );

      allow delete: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid
        || isAdmin()
      );
    }

    // ── Thành viên lớp ────────────────────────────────────────────────────────
    match /class_members/{membershipId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || ownsClass(resource.data.classId)
        || isAdminOrMod()
      );

      // Yêu cầu tham gia do API máy chủ tạo để học sinh không thể tự đặt status=active.
      allow create: if isSignedIn() && (
        ownsClass(request.resource.data.classId) || isAdmin()
      );

      allow update: if isSignedIn() && (
        ownsClass(resource.data.classId)
        || isAdmin()
      );

      allow delete: if isSignedIn() && (
        ownsClass(resource.data.classId)
        || isAdmin()
      );
    }

    // ── Nhóm lớp ───────────────────────────────────────────────────────────────
    match /class_groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isStaff();
      allow update, delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
        || isAdmin()
      );
    }

    // ── Chặn tất cả các collection chưa được khai báo ──────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
