rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return callerRole() == 'admin';
    }

    // Vai trò thực tế trong hệ thống: admin | mod | student | pending_teacher.
    // Giáo viên được duyệt sẽ có role 'mod' (xem admin/users). Không có role 'teacher'.
    function isStaff() {
      return callerRole() in ['admin', 'mod'];
    }

    function isAdminOrMod() {
      return callerRole() in ['admin', 'mod'];
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'mrhoangblue@gmail.com';
    }

    function ownsClass(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId
        == request.auth.uid;
    }

    // ── Người dùng ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Giáo viên đã duyệt có hồ sơ tìm kiếm được bởi người dùng đã đăng nhập.
      allow read: if isSignedIn() && (
        isOwner(userId)
        || isAdminOrMod()
        || resource.data.role in ['admin', 'mod']
      );

      // Tài khoản mới tự tạo hồ sơ nhưng không thể tự cấp quyền mod/admin.
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && (
          request.resource.data.role in ['student', 'pending_teacher']
          || (isBootstrapAdmin() && request.resource.data.role == 'admin')
        );

      // Chính chủ chỉ sửa các trường hồ sơ; role do admin/mod quản lý.
      allow update: if isOwner(userId) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'school', 'phoneNumber', 'searchKeywords', 'class', 'updatedAt'
        ])
        || (isBootstrapAdmin() && request.resource.data.role == 'admin')
      );

      // Admin/mod quản lý tài khoản: cấp role, khóa tài khoản, v.v.
      allow create, update, delete: if isSignedIn() && isAdminOrMod();
    }

    // ── Đề thi ─────────────────────────────────────────────────────────────────
    match /exams/{examId} {
      // Học sinh đã đăng nhập được đọc đề
      allow read: if isSignedIn();

      // Giáo viên/mod/admin tạo đề — API dùng Admin SDK nên rule này chỉ
      // áp dụng nếu client ghi trực tiếp (không qua API)
      allow create: if isSignedIn() && isStaff();

      // Chỉnh sửa/xóa: tác giả của đề HOẶC admin/mod
      allow update, delete: if isSignedIn() && (
        resource.data.authorEmail == request.auth.token.email
        || isAdminOrMod()
      );
    }

    // Mật khẩu đề chỉ được đọc/ghi bởi API dùng Admin SDK.
    match /exam_secrets/{examId} {
      allow read, write: if false;
    }

    // ── Bài nộp của học sinh ────────────────────────────────────────────────────
    match /submissions/{submissionId} {
      // Học sinh xem bài của mình, admin/mod xem tất cả
      allow read: if isSignedIn() && (
        resource.data.studentEmail == request.auth.token.email
        || isAdminOrMod()
      );
      // Học sinh tự nộp bài (tạo mới — điểm hiện do client tính, xem ghi chú dưới)
      allow create: if isSignedIn()
        && request.resource.data.studentEmail == request.auth.token.email;
      // Cập nhật: CHỈ khi bài còn đang làm dở (IN_PROGRESS) và vẫn của chính chủ,
      // không được đổi studentEmail. Sau khi đã nộp (COMPLETED) thì client KHÔNG
      // sửa được nữa → chặn mở lại bài cũ để ghi đè điểm. Admin/mod vẫn sửa được.
      allow update: if isSignedIn() && (
        isAdminOrMod()
        || (
          resource.data.studentEmail == request.auth.token.email
          && request.resource.data.studentEmail == resource.data.studentEmail
          && resource.data.status == "IN_PROGRESS"
        )
      );
      // Không ai được xóa bài nộp từ client
      allow delete: if false;

      // ⚠️ GHI CHÚ BẢO MẬT: điểm (scores) hiện được tính ở client rồi ghi lên đây,
      // nên một HS rành kỹ thuật vẫn có thể tự đặt điểm khi nộp. Để chặn triệt để
      // cần chấm điểm phía server (API dùng Admin SDK) rồi khoá field scores ở client.
    }

    // ── Lớp học ────────────────────────────────────────────────────────────────
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isStaff();

      // Học sinh chỉ được thêm chính UID của mình vào studentIds. Ghi class_members
      // ở rule bên dưới dùng cùng UID để hoàn tất dữ liệu thành viên.
      allow update: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid
        || isAdminOrMod()
        || (
          !(request.auth.uid in resource.data.studentIds)
          && request.auth.uid in request.resource.data.studentIds
          && request.resource.data.studentIds.hasAll(resource.data.studentIds)
          && request.resource.data.studentIds.size() == resource.data.studentIds.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'studentIds', 'updatedAt'
          ])
        )
      );

      allow delete: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid
        || isAdminOrMod()
      );
    }

    // ── Thành viên lớp ────────────────────────────────────────────────────────
    match /class_members/{membershipId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || ownsClass(resource.data.classId)
        || isAdminOrMod()
      );

      allow create: if isSignedIn()
        && request.resource.data.classId is string
        && request.resource.data.studentId is string
        && membershipId == request.resource.data.classId + '_' + request.resource.data.studentId
        && (
          request.resource.data.studentId == request.auth.uid
          || ownsClass(request.resource.data.classId)
          || isAdminOrMod()
        );

      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || ownsClass(resource.data.classId)
        || isAdminOrMod()
      );

      allow delete: if isSignedIn() && (
        resource.data.studentId == request.auth.uid
        || ownsClass(resource.data.classId)
        || isAdminOrMod()
      );
    }

    // ── Nhóm lớp ───────────────────────────────────────────────────────────────
    match /class_groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isStaff();
      allow update, delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
        || isAdminOrMod()
      );
    }

    // ── Chặn tất cả các collection chưa được khai báo ──────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
